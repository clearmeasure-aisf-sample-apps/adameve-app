<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The outermost project: the process that serves the published client and answers the health paths. It holds no
       game code. Published, it is the content of the container image (deployable "web"). -->
  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- No IIS: the process runs in a Linux container. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!-- The host has no static web assets of its own: its web root is the client's publish output (below). -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <!-- The image, made by the SDK without a Dockerfile and without a Docker daemon (build.ps1, step ContainerImage):
       container-image:<version>, on the ASP.NET Core runtime image without a shell, run by its unprivileged user. -->
  <PropertyGroup>
    <ContainerRepository>container-image</ContainerRepository>
    <ContainerFamily>noble-chiseled</ContainerFamily>
    <ContainerRuntimeIdentifier>linux-x64</ContainerRuntimeIdentifier>
    <ContainerImageFormat>Docker</ContainerImageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ContainerPort Include="8080" Type="tcp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AdamEve.UnitTests" />
  </ItemGroup>

  <!-- Host → Client: publishing the host publishes the client (Blazor WebAssembly, standalone) and takes its
       wwwroot, with the brotli and gzip files beside every file, as the web root of the host. Not a project
       reference: the host runs none of the client's code, and a standalone client's index.html gets its import map
       and its fingerprinted script names only from its own publish. -->
  <Target Name="PublishClient" AfterTargets="Publish">
    <PropertyGroup>
      <ClientPublishDir>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)client/</ClientPublishDir>
    </PropertyGroup>
    <RemoveDir Directories="$(ClientPublishDir);$(PublishDir)wwwroot" />
    <MSBuild Projects="../AdamEve.Client/AdamEve.Client.csproj" Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);Version=$(Version);PublishDir=$(ClientPublishDir);NoBuild=false" />
    <ItemGroup>
      <ClientFile Include="$(ClientPublishDir)wwwroot/**" />
    </ItemGroup>
    <Copy SourceFiles="@(ClientFile)" DestinationFolder="$(PublishDir)wwwroot/%(RecursiveDir)" />
    <Message Importance="high" Text="AdamEve.Client (published wwwroot) -> $(PublishDir)wwwroot" />
  </Target>

</Project>
