<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Blazor WebAssembly, standalone: the published wwwroot is the whole deployable. There is no server. -->
  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- [JSImport] and [JSExport] generate their marshalling code as unsafe code (design, section 7.1). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AdamEve.Content/AdamEve.Content.csproj" />
  </ItemGroup>

</Project>
