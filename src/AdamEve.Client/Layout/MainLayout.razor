@inherits LayoutComponentBase
@inject ContentLoadResult ContentCheck

<main>
    @if (ContentCheck.IsLoaded)
    {
        @Body
    }
    else
    {
        <h1>@GameInfo.Title</h1>
        <p class="content-failure" role="alert" data-testid="content-failure">@GameText.ContentFailure</p>
    }
</main>
